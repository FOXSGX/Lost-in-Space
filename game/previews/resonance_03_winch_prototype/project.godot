; Resonance 03 - Winch & Track Recovery Prototype
; Standalone project. Does not share files with Resonance 02 or the shipping stage.

config_version=5

[application]

config/name="Lost in Space - Resonance 03 Winch Prototype"
run/main_scene="res://resonance_03.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=600

