// Shared static surface: Blender-baked source albedo + diffuse irradiance.
// AgX display LUT is generated by the actual source Blender scene settings.
// Three realtime GGX worklight lobes retain view-dependent metal highlights.
shader_type spatial;
render_mode unshaded, cull_disabled;
uniform sampler2D agx_lut : filter_linear, repeat_disable;
uniform float metallic = 0.0;
uniform float roughness = 0.7;
uniform bool sourced_roughness = false;
uniform float exposure_gain = 1.0;
uniform float emission_gain = 0.0;
uniform vec3 emission_tint = vec3(0.0);
uniform float specular_gain = 0.32;
uniform float irradiance_scale = 8.0;
uniform bool log_irradiance = false;
uniform float resonance_response = 0.0;
uniform float panel_variation = 0.0;
uniform int debug_channel = 0;
uniform bool dynamic_lighting = false;
uniform bool energy_surface = false;
uniform float power_level = 1.0;
// Low-frequency indirect fallback for sparse/open baked receiver vertices.
uniform vec3 indirect_floor = vec3(0.12,0.14,0.18);
// Baked-shadow lift. The cart deck is a very dark albedo inside an open shell,
// so its baked irradiance is near zero and it reads as a hole. This only raises
// the darkest end and leaves lit surfaces untouched.
uniform float ambient_floor = 0.0;
// Albedo floor. Some authored materials (the cart deck at 0.026, the rubber at
// 0.012) are darker than any paint should be, so no amount of light can make
// them legible. Raising the base colour is the honest fix; adding emission or
// ambient light would just fog the whole scene.
uniform float albedo_floor = 0.0;
// Per-pixel rock detail for the generated cave shell. The shell is one smooth
// swept surface with only vertex irradiance, so without this it reads as a
// painted grey tube no matter how correct the lighting is. Detail is a pure
// multiplicative modulation of the lit colour: it cannot brighten a black hole
// or hide missing geometry, it only gives the rock strata and cracks to look at.
uniform float detail_strength = 0.0;
uniform float detail_scale = 0.42;
varying vec3 world_position;
varying vec3 world_normal;

float hash31(vec3 p) {
    return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453123);
}
float vnoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = hash31(i + vec3(0.0, 0.0, 0.0));
    float n100 = hash31(i + vec3(1.0, 0.0, 0.0));
    float n010 = hash31(i + vec3(0.0, 1.0, 0.0));
    float n110 = hash31(i + vec3(1.0, 1.0, 0.0));
    float n001 = hash31(i + vec3(0.0, 0.0, 1.0));
    float n101 = hash31(i + vec3(1.0, 0.0, 1.0));
    float n011 = hash31(i + vec3(0.0, 1.0, 1.0));
    float n111 = hash31(i + vec3(1.0, 1.0, 1.0));
    return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
               mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}
float fbm3(vec3 p) {
    return 0.55 * vnoise(p) + 0.30 * vnoise(p * 2.07) + 0.15 * vnoise(p * 4.03);
}
void vertex() {
    world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    world_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
}
vec3 agx(vec3 linear_color) {
    vec3 c = clamp((log2(max(linear_color, vec3(0.0009765625))) + 10.0) / 15.0, 0.0, 1.0) * 31.0;
    float b0 = floor(c.b); float b1 = min(b0 + 1.0, 31.0);
    // Blender image pixel row zero is bottom; texture row zero is top.
    vec2 a = vec2((b0*32.0+c.r+0.5)/1024.0, 1.0-(c.g+0.5)/32.0);
    vec2 b = vec2((b1*32.0+c.r+0.5)/1024.0, 1.0-(c.g+0.5)/32.0);
    return mix(texture(agx_lut,a).rgb, texture(agx_lut,b).rgb, fract(c.b));
}
vec3 srgb_to_linear(vec3 c) {
    return mix(c/12.92, pow((c+0.055)/1.055,vec3(2.4)), step(vec3(0.04045),c));
}
vec3 ggx(vec3 n,vec3 v,vec3 l,vec3 base,float metal,float r) {
    vec3 h=normalize(v+l);float nl=max(dot(n,l),0.0);float nv=max(dot(n,v),0.001);float nh=max(dot(n,h),0.0);float vh=max(dot(v,h),0.0);
    float a=max(r*r,0.035);float a2=a*a;float d=a2/(3.141593*pow(nh*nh*(a2-1.0)+1.0,2.0));
    float k=pow(r+1.0,2.0)/8.0;float g=(nl/(nl*(1.0-k)+k))*(nv/(nv*(1.0-k)+k));
    vec3 f0=mix(vec3(0.04),base,metal);vec3 f=f0+(1.0-f0)*pow(1.0-vh,5.0);
    return f*d*g/max(4.0*nv*nl,0.001)*nl;
}
void fragment() {
    vec3 base=max(vec3(UV.x,1.0-UV.y,UV2.x),vec3(0.0));
    // Authored albedo that is darker than real paint cannot be rescued by light.
    // Raise it to a legible floor instead of faking the light level.
    base=max(base,vec3(albedo_floor));
    float surface_roughness=sourced_roughness ? clamp(1.0-UV2.y,0.07,1.0) : roughness;
    vec3 irradiance=log_irradiance ? exp2(COLOR.rgb*irradiance_scale)-1.0 : COLOR.rgb*irradiance_scale;
    irradiance=max(irradiance,indirect_floor);
    vec3 n=normalize(world_normal);if(!FRONT_FACING)n=-n;
    vec3 v=normalize(CAMERA_POSITION_WORLD-world_position);
    if(dynamic_lighting) {
        // Source albedo stays constant in object space; light is evaluated in
        // world space every frame. No baked world irradiance follows the core.
        irradiance=vec3(0.55,0.65,0.8)*0.85;
        for(int j=0;j<3;j++) {
            vec3 lamp=j==0 ? vec3(-5.2,4.05,-0.85) : (j==1 ? vec3(2.0,4.35,-0.65) : vec3(8.0,4.1,0.1));
            vec3 dl=lamp-world_position;
            irradiance+=vec3(1.0,0.78,0.55)*max(dot(n,normalize(dl)),0.0)*8.0/(1.0+dot(dl,dl)*0.25);
        }
    }
    vec3 lighting=base*irradiance*mix(1.0,0.58,metallic);
    // Softly lift crushed baked shadows so dark mechanical surfaces keep their
    // panel definition instead of collapsing to a flat black silhouette.
    lighting+=base*ambient_floor;    vec3 resonance_delta=world_position-vec3(-2.5,2.9,2.2);
    lighting+=base*vec3(0.12,0.68,1.0)*resonance_response*3.0/(1.0+dot(resonance_delta,resonance_delta));
    if (detail_strength > 0.0) {
        vec3 p = world_position * detail_scale;
        float broad = fbm3(p);
        float bands = 0.5 + 0.5 * sin(world_position.y * 3.4 + broad * 3.2);
        float ridge = abs(fbm3(p * 1.85 + vec3(11.3, 5.1, 7.7)) - 0.5);
        float crack = 1.0 - smoothstep(0.0, 0.055, ridge);
        float detail = mix(1.0, 0.52 + 0.85 * broad + 0.18 * bands, detail_strength);
        detail *= mix(1.0, 1.0 - 0.50 * crack, detail_strength);
        lighting *= clamp(detail, 0.35, 1.55);
    }
    if(energy_surface)lighting*=mix(0.035,1.0,clamp(power_level,0.0,1.0));
    vec3 spec=vec3(0.0);
    for(int i=0;i<3;i++) {
        vec3 position=i==0 ? vec3(-5.2,4.22,-0.85) : (i==1 ? vec3(2.0,4.57,-0.65) : vec3(8.0,4.32,0.1));
        vec3 delta=position-world_position;float distance=length(delta);
        spec+=ggx(n,v,normalize(delta),base,metallic,surface_roughness)*vec3(1.0,0.78,0.55)*8.0/(1.0+distance*distance*0.25);
    }
    float panel=floor((world_position.x+5.6)/1.4);
    float variation=1.0-panel_variation*(0.5+0.5*sin(panel*2.63));
    lighting*=variation;
    vec3 scene_color=(lighting+spec*specular_gain+base*emission_tint*emission_gain)*exposure_gain;
    if(debug_channel==1)scene_color=base;
    if(debug_channel==2)scene_color=irradiance*0.3;
    vec3 display_color=agx(scene_color);
    ALBEDO=OUTPUT_IS_SRGB ? display_color : srgb_to_linear(display_color);
}
