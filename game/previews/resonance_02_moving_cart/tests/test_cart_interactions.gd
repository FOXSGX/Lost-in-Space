extends "res://tests/test_moving_cart.gd"

func start_from_console() -> void:
	check(await travel(Vector3(2.0,1.91,1.7)),"自由走到发车器")
	await face(Vector3(2.48,2.64,1.08))
	await press("repair")
	check(bool(cart.get("running")),"正常输入启动矿车")

func pick_body(body: RigidBody3D) -> void:
	var local: Vector3 = cart.to_local(body.global_position)
	check(await travel(Vector3(local.x,1.91,1.58)),"靠近指定货物")
	await face(cart.to_local(body.global_position) + Vector3.UP * 0.4)
	await press("pickup")
	await frames(40)
	check(int(body.get("carrier_id")) == 1 and str(body.get("phase")) == "held","F 拿起唯一物品归属",{"id":body.get("object_id"),"phase":body.get("phase")})

func lock_body(body: RigidBody3D,index: int) -> void:
	var slot: Vector3 = (cargo.get("slots") as Array[Vector3])[index]
	check(await travel(Vector3(slot.x,1.91,1.72)),"搬运至固定座前方")
	await face(slot)
	await press("deposit")
	await frames(85)
	check(str(body.get("phase")) == "locked" and int(body.get("slot")) == index,"G 引导定位并闭合锁爪",{"id":body.get("object_id"),"phase":body.get("phase"),"slot":body.get("slot")})

func run() -> void:
	await boot()
	check(await travel(Vector3(1,0,1.55)),"从菜单步行登车")
	var bodies: Array[RigidBody3D] = cargo.get("cargo") as Array[RigidBody3D]
	check(not bool(scene.call("request_action","cart_brake",99)),"未登记玩家不能操作")
	check(not bool(scene.call("request_action","repair",1,999)),"旧 revision 操作被拒绝")
	await start_from_console()
	# Let the low-friction cargo react to actual startup acceleration first.
	await frames(250)
	var slide: float = float(bodies[0].get("slip_max"))
	check(slide > 0.18,"未固定货物因真实加速产生滑动",{"slip_m":slide})
	await shot("01_loose_cargo")
	check(await travel(Vector3(-0.7,1.91,1.44)),"行驶中靠近扶手")
	await face(Vector3(-0.7,2.91,0.87))
	await press("repair")
	check(int(player.get("grip_id")) == 0,"E 建立抓扶关系")
	var grip_start: Vector3 = cart.to_local(player.global_position)
	Input.action_press("move_right")
	player.set("_camera_yaw_target",float(player.get("_camera_yaw_target")) + 1.3)
	await frames(1000)
	Input.action_release("move_right")
	var grip_end: Vector3 = cart.to_local(player.global_position)
	check(grip_start.distance_to(grip_end) < 0.15 and int(player.get("grip_id")) == 0,"抓扶期间转弯、观察镜头和移动输入不脱离",{"drift":grip_start.distance_to(grip_end)})
	await shot("02_grip_curve")
	await press("cart_brake")
	await frames(140)
	check(float(cart.get("speed")) < 0.001 and int(player.get("grip_id")) == 0,"抓扶时安全制动保持关系")
	var before_release: Vector3 = player.global_position
	await press("repair")
	check(int(player.get("grip_id")) == -1 and player.global_position.distance_to(before_release) < 0.08,"E 松开不瞬移、不永久锁定")
	await press("cart_recover")
	await frames(45)
	await pick_body(bodies[0])
	await shot("03_carry")
	check(await travel(Vector3(-0.9,1.91,1.55)),"持物走动")
	await face(Vector3(-0.9,2.0,2.8))
	await press("drop")
	await frames(60)
	check(str(bodies[0].get("phase")) == "free" and bodies[0].linear_velocity.length() < 0.15,"X 缓放恢复重力并稳定落地")
	await pick_body(bodies[0])
	await lock_body(bodies[0],0)
	await pick_body(bodies[1])
	await lock_body(bodies[1],1)
	check(int(cargo.call("locked_count")) == 2,"两件货物均可独立固定")
	await shot("04_both_locked")
	await start_from_console()
	await frames(650)
	var socket: Vector3 = (cargo.get("slots") as Array[Vector3])[0]
	check(cart.to_local(bodies[0].global_position).distance_to(socket) < 0.002,"固定货物在行驶中保持机械座位置")
	# Carry the second vessel during motion, then set it down using the shared mover.
	await press("cart_brake")
	await frames(140)
	await pick_body(bodies[1])
	check(str(bodies[1].get("phase")) == "held","停车后 F 解除固定")
	await start_from_console()
	await frames(180)
	await travel(Vector3(0.5,1.91,1.72))
	await face(Vector3(0.5,2.0,2.8))
	await press("drop")
	await frames(90)
	check(str(bodies[1].get("phase")) == "free" and cart.to_local(bodies[1].global_position).y > 1.8,"行驶中放下继承甲板速度，不穿透甲板")
	await shot("05_moving_drop")
	await press("cart_brake")
	await frames(140)
	# Explicit failure injection tests, separate from input replay evidence.
	bodies[1].global_position = cart.to_global(Vector3(0,-1.0,6.0))
	bodies[1].linear_velocity = Vector3.ZERO
	bodies[1].reset_physics_interpolation()
	await frames(10)
	await press("cart_recover")
	await frames(40)
	check(str(bodies[1].get("phase")) == "free" and cart.to_local(bodies[1].global_position).y > 1.8,"注入货物滑落后 R 明确回收，未算固定")
	player.call("restore_at",cart.to_global(Vector3(1,0.1,-2.0)))
	await frames(20)
	await press("cart_recover")
	await frames(25)
	check(bool(cart.call("contains_point",player.global_position)) and int(player.get("recovery_count")) > 0,"注入玩家离车后救援登车，插值复位")
	await shot("06_recovered")
	scene.call("reset_run")
	await frames(45)
	check(int(cargo.call("locked_count")) == 0 and int(player.get("grip_id")) == -1 and int(player.get("carrying")) == 0 and float(cart.get("distance")) == 0.0,"任务重置清空抓扶、归属和固定状态")
	check(await travel(Vector3(1,0,1.55)),"重置后可重新登车")
	check(camera_overlaps == 0,"运行采样未检测相机穿模",{"overlap_samples":camera_overlaps})
	await finish()
