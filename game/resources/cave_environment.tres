[gd_resource type="Environment" format=3]

; NOTE: the previous file put every setting inside an unused [sub_resource]
; block, so Godot loaded a completely default Environment (black ambient, no
; glow, no fog, linear tonemap). That is why the cave walls read as a void.
; Properties must live on the top-level [resource].

[resource]
background_mode = 1
background_color = Color(0.012, 0.02, 0.033, 1)
ambient_light_source = 2
ambient_light_color = Color(0.40, 0.46, 0.58, 1)
ambient_light_energy = 0.95
reflected_light_source = 2
tonemap_mode = 2
tonemap_exposure = 1.18
tonemap_white = 6.0
glow_enabled = true
glow_intensity = 0.55
glow_strength = 0.9
glow_bloom = 0.08
glow_blend_mode = 1
glow_hdr_threshold = 0.95
fog_enabled = true
fog_light_color = Color(0.09, 0.14, 0.22, 1)
fog_light_energy = 0.6
fog_density = 0.008
adjustment_enabled = true
adjustment_brightness = 1.0
adjustment_contrast = 1.04
adjustment_saturation = 1.06
