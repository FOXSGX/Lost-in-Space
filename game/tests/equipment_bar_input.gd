extends "res://tests/inventory_input.gd"

func click(button: Button) -> void:
    await mouse(MOUSE_BUTTON_LEFT, button.get_global_rect().get_center())

func run() -> void:
    if DisplayServer.get_name() == "headless":
        print("EQUIPMENT_BAR_INPUT_NOT_RUN")
        quit(1)
        return
    output = ProjectSettings.globalize_path("res://").path_join("../work/equipment-bar-20261023/previews").simplify_path()
    DirAccess.make_dir_recursive_absolute(output)
    main = load("res://scenes/main_3d.tscn").instantiate() as Main3D
    root.add_child(main)
    await process_frame
    var guard: ReplayInputGuard = ReplayInputGuard.new()
    guard.process_mode = Node.PROCESS_MODE_ALWAYS
    root.add_child(guard)
    main.network_port = 28328
    main._ship_session.persistence_enabled = false
    main._create_host()
    await frames(10)
    var items: CrewItems3D = main._items
    var ship: ShipSession3D = main._ship_session
    var player: SpacePlayer3D = main.players[1] as SpacePlayer3D
    check(items._equipment_cells.size() == 2 and items.ensure_bag(1).equipment.size() == 2 and items.ensure_bag(1).slots.size() == 2, "装备栏或手持栏容量不正确")
    items.add_item(1, "oxygen", -1, {"oxygen": 37.5})
    items.add_item(1, "penguin")
    await mouse(MOUSE_BUTTON_LEFT)
    check(items.has_jet(1) and items.equipment_index(1, "oxygen") == 0 and items.occupied(1) == 1, "氧气瓶没有装入装备位")
    ship.credits = 100
    await stand(ShipDevices3D.point_for("gear") + Vector3(0, 0, 1.3), 0.0, 0.1)
    await key(KEY_E)
    await click(ship._computer._action)
    check(ship.has_gear(1, "thermal_suit") and items.equipment_index(1, "thermal_suit") == 1 and ship.credits == 55, "第二个装备位不能装入外套")
    await click(ship._computer._cards["gear_wide_scanner"].button as Button)
    check(ship._computer._action.disabled and ship._computer._action.text == "装备栏已满", "满装备栏未禁用购买")
    ship.request("computer_action", "gear_wide_scanner")
    check(ship.credits == 55 and ship.gear_stock.wide_scanner == 0, "满装备栏仍扣款或购买")
    await key(KEY_TAB)
    await key(KEY_G)
    check(not bool(items.ensure_bag(1).equipment_active) and items.drops.is_empty(), "电脑中 Tab/G 操作了装备栏")
    await key(KEY_ESCAPE)
    items.add_item(1, "medical")
    await stand(Vector3(0, 0, 6), 0.0, 0.12)
    await frames(65)
    await shot("01-two-equipped-items")
    await key(KEY_TAB)
    check(bool(items.ensure_bag(1).equipment_active) and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED and not main.is_journal_visible(), "Tab 未选择装备栏或打断了环视")
    var hand: int = int(items.ensure_bag(1).selected)
    var stock_item: Dictionary = items.world_catalog(1).filter(func(entry: Dictionary) -> bool: return entry.get("source", "") == "stock")[0]
    check(not items.pickup(1, stock_item) and bool(items.ensure_bag(1).equipment_active), "拾取失败仍切换了当前栏")
    await mouse(MOUSE_BUTTON_WHEEL_UP)
    check(int(items.ensure_bag(1).equipment_selected) == 0 and int(items.ensure_bag(1).selected) == hand, "滚轮改动了另一栏的选格")
    player.health = 3
    await mouse(MOUSE_BUTTON_LEFT)
    check(player.health == 3 and items.count_kind(1, "medical") == 1, "装备栏焦点仍使用了手中物品")
    await shot("02-equipment-selected")
    var oxygen: float = items.tank_oxygen(1)
    await key(KEY_G)
    check(not items.has_jet(1) and items.occupied(1) == 2 and items.drops.size() == 1 and ship.has_gear(1, "thermal_suit"), "满手持栏卸装失败或卸错装备")
    check(absf(float(items.drops[0].oxygen) - oxygen) < 0.05, "卸下氧气瓶丢失余量")
    await key(KEY_G)
    check(items.drops.size() == 1, "空装备位重复卸下生成了物品")
    await frames(80)
    var bottle: RigidBody3D = items._prop_bodies.get(items.drops[0].uid) as RigidBody3D
    check(bottle != null and not bottle.freeze and bottle.position.y < 0.5, "卸下装备没有落地刚体")
    await stand(Vector3(0, 0, 7.2), 0.0, 0.4)
    await shot("03-unequipped-on-floor")
    await key(KEY_TAB)
    check(not bool(items.ensure_bag(1).equipment_active) and int(items.ensure_bag(1).selected) == hand, "再次 Tab 没返回原手持格")
    await stand(Vector3(3, 0, 6), 0.0, 0.12)
    await key(KEY_G)
    check(items.count_kind(1, "medical") == 0 and ship.has_gear(1, "thermal_suit"), "手持栏 G 卸错装备")
    var drops_before: int = items.drops.size()
    await key(KEY_G)
    check(items.drops.size() == drops_before and ship.has_gear(1, "thermal_suit"), "手持空格 G 仍卸下了装备")
    await stand(Vector3(0, 0, 6), 0.0, 0.15)
    await key(KEY_2)
    await key(KEY_TAB)
    await key(KEY_E)
    check(items.count_kind(1, "oxygen") == 1, "无法拾回卸下的氧气瓶")
    check(not bool(items.ensure_bag(1).equipment_active) and items.selected(1).get("kind", "") == "oxygen", "拾回氧气瓶没有切回手持栏并选中新物品")
    await mouse(MOUSE_BUTTON_LEFT)
    check(items.has_jet(1) and absf(items.tank_oxygen(1) - oxygen) < 0.05, "重新装备氧气瓶丢失余量")
    await key(KEY_TAB)
    await mouse(MOUSE_BUTTON_WHEEL_DOWN)
    check(int(items.ensure_bag(1).equipment_selected) == 1, "滚轮未选择第二个装备位")
    await key(KEY_G)
    check(not ship.has_gear(1, "thermal_suit") and items.has_jet(1), "卸下外套未撤销效果或误卸氧气瓶")
    check(items.drops.any(func(item: Dictionary) -> bool: return item.kind == "thermal_suit"), "卸下外套没有生成实体")
    check(items.available_gear("thermal_suit") == 0, "地面装备仍可从电脑重复领取")
    await frames(80)
    await key(KEY_E)
    check(not bool(items.ensure_bag(1).equipment_active) and items.selected(1).get("kind", "") == "thermal_suit", "拾回装备没有切回手持栏")
    await mouse(MOUSE_BUTTON_LEFT)
    check(ship.has_gear(1, "thermal_suit") and items.has_jet(1), "卸下外套不能拾回并重新装备")
    await shot("04-equipment-restored")
    root.size = Vector2i(1920, 1080)
    await frames(8)
    check(root.get_visible_rect().encloses(items._equipment_column.get_global_rect()), "大分辨率装备栏超出画面")
    check(root.get_visible_rect().encloses(items._bar.get_global_rect()), "大分辨率手持栏超出画面")
    await shot("05-layout-1920")
    root.size = Vector2i(1280, 720)
    await frames(8)
    await key(KEY_ESCAPE)
    check(main._settings_panel.get_global_rect().encloses((main._settings_buttons.toggle_equipment as Button).get_global_rect()), "新增切栏改键行超出设置面板")
    await key(KEY_TAB)
    check(not bool(items.ensure_bag(1).equipment_active), "设置中 Tab 改动了装备栏")
    await shot("06-settings")
    await key(KEY_ESCAPE)
    var level: float = items.tank_oxygen(1)
    await stand(ShipHub3D.AIRLOCK, PI, 0.0)
    await key(KEY_E)
    check(not ship.in_hub and not items.has_jet(1) and not ship.has_gear(1, "thermal_suit"), "训练未隔离正式装备")
    await stand(ShipTutorial3D.ENTRY_POINT, PI, 0.0)
    await key(KEY_E)
    check(ship.in_hub and items.has_jet(1) and ship.has_gear(1, "thermal_suit") and absf(items.tank_oxygen(1) - level) < 0.05, "训练往返没有恢复双装备与余量")
    main.start_planet("demo")
    await frames(6)
    await key(KEY_TAB)
    check(bool(items.ensure_bag(1).equipment_active) and not main.is_journal_visible(), "星球 Tab 仍打开日志")
    await key(KEY_J)
    check(main.is_journal_visible(), "J 没有打开原日志功能")
    await key(KEY_J)
    await key(KEY_TAB)
    check(not bool(items.ensure_bag(1).equipment_active), "星球 Tab 无法切回手持栏")
    main._show_home()
    main.queue_free()
    await frames()
    print("EQUIPMENT_BAR_INPUT: %d checks, %d failures" % [checks, failures.size()])
    quit(0 if failures.is_empty() else 1)
