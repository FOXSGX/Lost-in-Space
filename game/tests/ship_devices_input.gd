extends "res://tests/inventory_input.gd"

func device(id: String) -> void:
    var point: Vector3 = ShipDevices3D.point_for(id)
    point.y = 0
    point.z += 1.6 if id.begins_with("pilot_") else 1.3
    await stand(point, 0.0, -0.15 if id.begins_with("pilot_") else 0.15)

func run() -> void:
    if DisplayServer.get_name() == "headless":
        print("SHIP_DEVICES_INPUT_NOT_RUN: graphical display required")
        quit()
        return
    output = ProjectSettings.globalize_path("res://").path_join("../art-source/editable/spaceship-cabin/devices/previews").simplify_path()
    DirAccess.make_dir_recursive_absolute(output)
    main = load("res://scenes/main_3d.tscn").instantiate() as Main3D
    root.add_child(main)
    await process_frame
    var guard: ReplayInputGuard = ReplayInputGuard.new()
    guard.process_mode = Node.PROCESS_MODE_ALWAYS
    root.add_child(guard)
    main.network_port = 28232
    main._ship_session.persistence_enabled = false
    main._create_host()
    await frames(8)
    var ship: ShipSession3D = main._ship_session
    var player: SpacePlayer3D = main.players[1] as SpacePlayer3D
    check(Input.mouse_mode == Input.MOUSE_MODE_CAPTURED and ship._layer.find_children("*", "BaseButton", true, false).is_empty(), "第一人称仍依赖 HUD 按钮")
    await stand(Vector3(0, 0, -6.5), 0.0, 0.0)
    await shot("01-four-cockpits")
    await device("pilot_0")
    await key(KEY_E)
    check(ship.station_owners.get(0, 0) == 1 and ship.ready_peers.has(1) and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED, "实际 E 无法就位或丢失第一人称")
    await shot("02-pilot-ready")
    await key(KEY_E)
    check(ship.station_owners.is_empty() and ship.launch_remaining < 0, "实际 E 未取消就位")
    await key(KEY_E)
    Input.action_press("move_down")
    await frames(35)
    Input.action_release("move_down")
    check(ship.station_owners.is_empty(), "实际走离驾驶台没有取消")
    await device("route_electromagnetic")
    await key(KEY_E)
    check(ship.selected_destination == "electromagnetic" and not ship.has_panel(), "航线终端没有直接选共振星")
    await shot("03-route-terminals")
    await device("route_demo")
    await key(KEY_E)
    check(ship.selected_destination == "demo", "航线无法切回霜烬星")
    await device("repair")
    var parts: int = int(ship.stock.parts)
    await key(KEY_E)
    check(ship.hull == 100 and ship.stock.parts == parts - 1 and not ship.has_panel(), "实际 E 维修失败")
    await device("refill")
    player.health = 2
    player.oxygen = 20
    await key(KEY_E)
    check(player.health == 5 and player.oxygen == 100 and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED, "实际 E 补给失败")
    ship.credits = 100
    await device("craft_oxygen")
    var before: int = int(ship.stock.oxygen)
    await key(KEY_E)
    check(ship.credits == 95 and ship.stock.oxygen == before + 1, "实际 E 制作费用或库存不守恒")
    await device("gear_thermal_suit")
    await key(KEY_E)
    check(ship.credits == 50 and ship.gear_assignments.get(1, "") == "thermal_suit", "实际 E 无法购买/装备")
    await shot("04-equipment-terminal")
    await key(KEY_E)
    check(ship.credits == 50, "装备终端重复收取费用")
    await device("toy_penguin")
    await key(KEY_E)
    check(main._items.count_kind(1, "penguin") == 1, "道具柜不能领取实体道具")
    await device("store")
    await key(KEY_E)
    check(main._items.occupied(1) == 0, "道具无法存回")
    var medical_before: int = int(ship.stock.medical)
    await stand(ShipHub3D.STORAGE, PI / 2.0, 0.25)
    await key(KEY_E)
    check(main._items.count_kind(1, "medical") == 1, "实体医疗包不能直接拾取")
    await device("store")
    await key(KEY_E)
    check(main._items.count_kind(1, "medical") == 0 and ship.stock.medical == medical_before, "归还设备没有保持补给守恒")
    await device("mission")
    await key(KEY_E)
    check(ship.has_panel() and ship._panel.find_children("*", "BaseButton", true, false).is_empty(), "任务记录仍要求点击按钮")
    await key(KEY_ESCAPE)
    check(not ship.has_panel() and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED, "记录不能用 Esc 关闭并恢复环视")
    await stand(ShipHub3D.AIRLOCK, PI, 0.0)
    await key(KEY_E)
    check(not ship.in_hub and ship._layer.find_children("*", "BaseButton", true, false).is_empty(), "训练仍有返回按钮")
    await stand(ShipTutorial3D.ENTRY_POINT, PI, 0.0)
    await key(KEY_E)
    check(ship.in_hub, "训练舱门不能返回")
    await device("pilot_3")
    await key(KEY_E)
    check(ship.station_owners.get(3, 0) == 1 and ship.launch_remaining > 0, "单人不能使用第四驾驶台")
    await shot("05-auto-launch")
    await frames(200)
    check(main.game_started and not main.ship_active, "实际就位倒数后没有自动出发")
    main.return_to_ship("设备流程验证结束")
    await frames()
    await device("exit")
    await key(KEY_E)
    check(main.ship_active, "离舰没有进行二次确认")
    await shot("06-exit-terminal")
    await key(KEY_E)
    check(not main.ship_active and main._screen_view == "home", "离舰设备不能退出房间")
    main.queue_free()
    await frames()
    print("SHIP_DEVICES_INPUT: %d checks, %d failures" % [checks, failures.size()])
    quit(0 if failures.is_empty() else 1)
