extends "res://tests/inventory_input.gd"

func click(button: Button) -> void:
    await mouse(MOUSE_BUTTON_LEFT, button.get_global_rect().get_center())

func device(id: String) -> void:
    var point: Vector3 = ShipDevices3D.point_for(id)
    point += Vector3(1.6, 0, 0) if id == "store" else Vector3(0, 0, 1.3)
    await stand(point, PI / 2.0 if id == "store" else 0.0, 0.12)
    await key(KEY_E)
    check(main._ship_session.has_panel() and Input.mouse_mode == Input.MOUSE_MODE_VISIBLE, "E 未打开电脑或显示光标：" + id)

func select_option(id: String) -> void:
    var ui: ShipComputerUI = main._ship_session._computer
    await click(ui._cards[id].button as Button)
    check(ui.selection.id == id, "鼠标未选中图形卡：" + id)

func layout() -> void:
    var ui: ShipComputerUI = main._ship_session._computer
    var bounds: Rect2 = root.get_visible_rect()
    var window: Control = ui.find_child("ComputerWindow", true, false) as Control
    check(bounds.encloses(window.get_global_rect()), "电脑界面超出画面")
    for control: Node in ui.find_children("*", "Button", true, false):
        var button: Button = control as Button
        if button.is_visible_in_tree():
            check(window.get_global_rect().encloses(button.get_global_rect()), "按钮超出电脑界面：" + String(button.name))

func close() -> void:
    await key(KEY_ESCAPE)
    check(not main._ship_session.has_panel() and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED, "Esc 未关闭电脑并恢复环视")

func run() -> void:
    if DisplayServer.get_name() == "headless":
        print("SHIP_COMPUTERS_INPUT_NOT_RUN: graphical display required")
        quit(1)
        return
    output = ProjectSettings.globalize_path("res://").path_join("../work/ship-computers-20261023/previews").simplify_path()
    DirAccess.make_dir_recursive_absolute(output)
    main = load("res://scenes/main_3d.tscn").instantiate() as Main3D
    root.add_child(main)
    await process_frame
    var guard: ReplayInputGuard = ReplayInputGuard.new()
    guard.process_mode = Node.PROCESS_MODE_ALWAYS
    root.add_child(guard)
    main.network_port = 28325
    main._ship_session.persistence_enabled = false
    main._create_host()
    await frames(12)
    var ship: ShipSession3D = main._ship_session
    var player: SpacePlayer3D = main.players[1] as SpacePlayer3D
    ship.credits = 200
    main.credits = 2000
    check(ship.device_room().devices.size() == 14, "各功能区未合并为独立电脑")
    await stand(Vector3(0, 0, 5.7), 0.0, 0.05)
    await shot("01-world-route-computer")
    await device("routes")
    check(ship.selected_destination == "demo", "打开电脑直接改了航线")
    await key(KEY_RIGHT)
    await key(KEY_ENTER)
    check(ship._computer.selection.id == "route_electromagnetic", "方向键和 Enter 无法选择图形卡")
    await select_option("route_electromagnetic")
    check(ship.selected_destination == "demo", "点卡片时提前执行操作")
    layout()
    await shot("02-route-screen")
    await click(ship._computer._action)
    check(ship.selected_destination == "electromagnetic", "确认航线未执行")
    await select_option("route_demo")
    await click(ship._computer._action)
    await close()
    await device("craft")
    var oxygen: int = int(ship.stock.oxygen)
    await select_option("craft_oxygen")
    await click(ship._computer._action)
    check(ship.stock.oxygen == oxygen + 1 and ship.credits == 195, "制作未正确扣款入库")
    await shot("03-craft-screen")
    await close()
    await device("gear")
    await select_option("gear_wide_scanner")
    await click(ship._computer._action)
    check(ship.gear_assignments.get(1, "") == "wide_scanner" and ship.credits == 140, "装备未正确购买并装备")
    check(ship._computer._action.disabled, "已装备的物品仍可重复扣款")
    await shot("04-gear-screen")
    await close()
    await device("toy")
    await select_option("toy_penguin")
    await click(ship._computer._action)
    check(main._items.count_kind(1, "penguin") == 1, "道具领取失败")
    await select_option("toy_bubble")
    await click(ship._computer._action)
    check(main._items.occupied(1) == 2 and ship._computer._action.disabled, "满物品栏没有禁用领取")
    layout()
    await shot("05-toy-screen")
    await close()
    await device("store")
    await select_option("store_0")
    await click(ship._computer._action)
    await select_option("store_1")
    await click(ship._computer._action)
    check(main._items.occupied(1) == 0, "归还电脑无法选择两格物品")
    main._items.add_item(1, "oxygen", -1, {"oxygen": 9.5})
    main._items.add_item(1, "oxygen", -1, {"oxygen": 37.5})
    await select_option("store_1")
    await click(ship._computer._action)
    var remaining: Dictionary = main._items.ensure_bag(1).slots[0]
    check(is_equal_approx(float(remaining.get("oxygen", -1)), 9.5) and ship.oxygen_levels.has(37.5), "归还第二瓶时移除了第一瓶或丢失瓶内余量")
    await select_option("store_0")
    await click(ship._computer._action)
    check(main._items.occupied(1) == 0 and ship.oxygen_levels.has(9.5), "第一瓶余量未保留")
    await close()
    await device("skin")
    await select_option("skin_gala")
    await shot("06-skin-screen")
    await click(ship._computer._action)
    check(main.player_skins.get(1, "") == "gala" and main.credits == 800, "换装电脑未扣正确星币或换装")
    await close()
    await device("repair")
    var parts: int = int(ship.stock.parts)
    await click(ship._computer._action)
    check(ship.hull == 100 and ship.stock.parts == parts - 1 and ship._computer._action.disabled, "维修界面未执行或没有更新状态")
    await shot("07-repair-screen")
    await close()
    player.health = 2
    player.oxygen = 20
    await device("refill")
    await click(ship._computer._action)
    check(player.health == 5 and player.oxygen == 100, "补给电脑未恢复")
    await close()
    await device("mission")
    await shot("08-log-screen")
    await click(ship._computer._action)
    check(not ship.has_panel(), "记录按钮不能关闭电脑")
    await stand(ShipDevices3D.point_for("pilot_0") + Vector3(0, -0.61, 1.6), 0.0, -0.15)
    await key(KEY_E)
    check(ship.station_owners.get(0, 0) == 1 and not ship.has_panel(), "驾驶席 E 就位被电脑界面取代")
    await key(KEY_E)
    check(ship.station_owners.is_empty(), "驾驶席 E 未取消就位")
    await key(KEY_E)
    Input.action_press("move_down")
    await frames(35)
    Input.action_release("move_down")
    check(ship.station_owners.is_empty(), "实际离开驾驶席未取消就位")
    await stand(ShipHub3D.AIRLOCK, PI, 0.0)
    await key(KEY_E)
    check(not ship.in_hub and not ship.has_panel(), "训练舱门不能进入或残留电脑界面")
    await stand(ShipTutorial3D.ENTRY_POINT, PI, 0.0)
    await key(KEY_E)
    check(ship.in_hub and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED, "训练返回未恢复主舱环视")
    await device("craft")
    ship.credits = 0
    await frames()
    check(ship._computer._action.disabled, "余额不足仍能制作")
    ship.credits = 100
    player.teleport_to(Vector3(0, 0, 6))
    var before: int = int(ship.stock.medical)
    ship.request("computer_action", "craft_medical")
    check(ship.stock.medical == before and ship.credits == 100, "离开电脑后仍能远程操作")
    await close()
    await device("toy")
    root.size = Vector2i(1920, 1080)
    await frames(8)
    layout()
    await shot("09-layout-1920")
    await close()
    root.size = Vector2i(1280, 720)
    await frames(8)
    await stand(ShipDevices3D.point_for("pilot_3") + Vector3(0, -0.61, 1.6), 0.0, -0.15)
    await key(KEY_E)
    await frames(200)
    check(main.game_started and not main.ship_active, "电脑关闭后驾驶席不能自动出发")
    main.return_to_ship("电脑流程回归结束")
    await frames()
    await device("exit")
    await click(ship._computer._action)
    check(main.ship_active and ship._computer._action.text == "确认离开", "离舰未二次确认")
    await close()
    await device("exit")
    await click(ship._computer._action)
    check(main.ship_active, "关闭再打开保留了离舰确认")
    await click(ship._computer._action)
    check(not main.ship_active and main._screen_view == "home", "离舰确认不能退出")
    main.queue_free()
    await frames()
    print("SHIP_COMPUTERS_INPUT: %d checks, %d failures" % [checks, failures.size()])
    quit(0 if failures.is_empty() else 1)
