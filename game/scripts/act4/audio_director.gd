class_name R04Audio
extends Node
## Sound routing for the prototype. All WAVs are original synthesized assets
## generated by pipeline/make_audio.py.

const SFX_DIR := "res://assets/audio/sfx/"

const SOUND_NAMES: Array[String] = [
	"hammer_impact", "resonance_strike", "crystal_pulse", "crystal_lift",
	"crystal_seat", "crystal_wrong", "resonance_dead_end", "resonance_weak",
	"hammer_ratchet", "hammer_creak", "cart_roll", "cart_clank", "work_lamp",
	"alarm_loop", "steam_burst", "rail_cut", "gate_open", "beacon_ping",
	"cave_loop", "drone_loop", "footstep_1", "footstep_2", "footstep_3",
	"ui_rotate", "weak_release", "success_chime", "radio_beep",
]

const LOOPING: Array[String] = ["hammer_creak", "cart_roll", "alarm_loop", "cave_loop", "drone_loop"]

var _streams: Dictionary = {}
var _players_3d: Array[AudioStreamPlayer3D] = []
var _players_2d: Array[AudioStreamPlayer] = []
var _loops: Dictionary = {}
var _next_3d: int = 0
var _next_2d: int = 0
var _footstep_index: int = 0


func _ready() -> void:
	add_to_group("audio_director")
	name = "AudioDirector"
	_load_streams()
	for index: int in range(14):
		var player: AudioStreamPlayer3D = AudioStreamPlayer3D.new()
		player.name = "SFX3D_%d" % index
		player.bus = "SFX"
		player.unit_size = 9.0
		player.max_distance = 42.0
		player.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(player)
		_players_3d.append(player)
	for index: int in range(5):
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		player.name = "UI_%d" % index
		player.bus = "UI"
		add_child(player)
		_players_2d.append(player)
	start_loop("cave_loop", 0.42)
	start_loop("drone_loop", 0.28)


func _load_streams() -> void:
	for sound_name: String in SOUND_NAMES:
		var path: String = SFX_DIR + sound_name + ".wav"
		if not ResourceLoader.exists(path):
			push_warning("Missing audio: " + path)
			continue
		var stream: AudioStream = load(path) as AudioStream
		if stream == null:
			continue
		if sound_name in LOOPING and stream is AudioStreamWAV:
			var wav: AudioStreamWAV = (stream as AudioStreamWAV).duplicate() as AudioStreamWAV
			wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
			wav.loop_begin = 0
			wav.loop_end = int(wav.get_length() * float(wav.mix_rate))
			stream = wav
		_streams[sound_name] = stream


func has_sound(sound_name: String) -> bool:
	return _streams.has(sound_name)


func play_at(sound_name: String, position_value: Vector3, volume: float = 0.7, pitch: float = 1.0) -> void:
	if not _streams.has(sound_name):
		return
	var player: AudioStreamPlayer3D = _pick_3d()
	player.stream = _streams[sound_name] as AudioStream
	player.global_position = position_value
	player.volume_db = linear_to_db(clampf(volume, 0.001, 1.5))
	player.pitch_scale = clampf(pitch, 0.6, 1.6)
	player.play()


func play_ui(sound_name: String, volume: float = 0.6) -> void:
	if not _streams.has(sound_name):
		return
	var player: AudioStreamPlayer = _pick_2d()
	player.stream = _streams[sound_name] as AudioStream
	player.volume_db = linear_to_db(clampf(volume, 0.001, 1.5))
	player.play()


func play_footstep(position_value: Vector3, volume: float = 0.3) -> void:
	_footstep_index = (_footstep_index + 1) % 3
	var names: Array[String] = ["footstep_1", "footstep_2", "footstep_3"]
	play_at(names[_footstep_index], position_value, volume, 0.92 + float(_footstep_index) * 0.05)


func start_loop(sound_name: String, volume: float = 0.5) -> void:
	if not _streams.has(sound_name):
		return
	if _loops.has(sound_name):
		var existing: AudioStreamPlayer = _loops[sound_name] as AudioStreamPlayer
		if existing.playing:
			return
	var player: AudioStreamPlayer = AudioStreamPlayer.new()
	player.name = "Loop_" + sound_name
	player.bus = "Ambience" if sound_name in ["cave_loop", "drone_loop"] else "SFX"
	player.stream = _streams[sound_name] as AudioStream
	player.volume_db = linear_to_db(clampf(volume, 0.001, 1.5))
	add_child(player)
	_loops[sound_name] = player
	player.play()


func stop_loop(sound_name: String) -> void:
	if not _loops.has(sound_name):
		return
	var player: AudioStreamPlayer = _loops[sound_name] as AudioStreamPlayer
	player.stop()
	player.queue_free()
	_loops.erase(sound_name)


func stop_all_loops() -> void:
	for sound_name: Variant in _loops.keys():
		stop_loop(str(sound_name))


func _pick_3d() -> AudioStreamPlayer3D:
	for index: int in range(_players_3d.size()):
		var candidate: int = (_next_3d + index) % _players_3d.size()
		if not _players_3d[candidate].playing:
			_next_3d = (candidate + 1) % _players_3d.size()
			return _players_3d[candidate]
	var fallback: AudioStreamPlayer3D = _players_3d[_next_3d]
	_next_3d = (_next_3d + 1) % _players_3d.size()
	return fallback


func _pick_2d() -> AudioStreamPlayer:
	for index: int in range(_players_2d.size()):
		var candidate: int = (_next_2d + index) % _players_2d.size()
		if not _players_2d[candidate].playing:
			_next_2d = (candidate + 1) % _players_2d.size()
			return _players_2d[candidate]
	var fallback: AudioStreamPlayer = _players_2d[_next_2d]
	_next_2d = (_next_2d + 1) % _players_2d.size()
	return fallback
